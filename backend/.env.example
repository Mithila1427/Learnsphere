PORT=
MONGO_URI=
JWT_SECRET=very_strong_secret_here_please_change
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SMTP for sending OTPs (choose one approach below)
# Option A: Mailtrap (recommended for dev):
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="AI Doubt Solver <no-reply@example.com>"

# Option B: Gmail with App Password (only if you have 2FA enabled)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_gmail_app_password

# Dev helper: if you don't want to configure SMTP you can use "console mode" (see server changes)
DEV_EMAIL_MODE=console
